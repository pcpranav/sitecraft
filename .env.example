# AI Provider Keys (at least one required)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Supabase (required for auth, cloud save, persistent rate limiting)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Netlify Deploy (optional — for one-click deploy feature)
NETLIFY_ACCESS_TOKEN=
NETLIFY_SITE_ID=

# Admin bypass token (optional — skips rate limiting)
ADMIN_TOKEN=
