# Auth.js
AUTH_SECRET=              # generate: openssl rand -base64 32
AUTH_GOOGLE_ID=           # Google Cloud Console OAuth 2.0 Client ID
AUTH_GOOGLE_SECRET=       # Google Cloud Console OAuth 2.0 Client Secret

# Vercel Postgres (auto-injected by Vercel integration; set locally for dev)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# AI providers — all four are 70B-class free-tier endpoints.
# At least one of these must be set, matching the model picked in the UI.
GROQ_API_KEY=             # console.groq.com
CEREBRAS_API_KEY=         # cloud.cerebras.ai
OPENROUTER_API_KEY=       # openrouter.ai/keys (DeepSeek R1 free tier)
CF_ACCOUNT_ID=            # Cloudflare dashboard → account ID
CF_AI_TOKEN=              # Cloudflare → API tokens → Workers AI scope
