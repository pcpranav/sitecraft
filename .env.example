# AI Provider Keys (both free tier)
GEMINI_API_KEY=
GROQ_API_KEY=

# Supabase (required for auth, cloud save, persistent rate limiting)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Vercel Deploy (optional — for one-click deploy feature)
# Create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=
# Optional: deploy under a team/org account
VERCEL_TEAM_ID=
# Optional: link deploys to an existing Vercel project name
VERCEL_PROJECT_NAME=

# Admin bypass token (optional — skips rate limiting)
ADMIN_TOKEN=

# Per-user AI rate limit (requests per hour, default 60)
AI_RATE_LIMIT_PER_HOUR=60
# Anonymous AI rate limit (requests per hour per IP, default 5)
AI_ANON_RATE_LIMIT_PER_HOUR=5
